{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "standard": {
            "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
        }
    },
    "handlers": {
        "stderr": {
            "level": "INFO",
            "class": "logging.StreamHandler",
            "formatter": "standard",
            "stream": "ext://sys.stderr"
        }
    },
    "loggers": {
        "earthkit.data": {
            "level": "ERROR"
        },
        "meteodatalab": {
            "level": "WARNING"
        },
        "multiurl": {
            "level": "WARNING"
        },
        "httpx": {
            "level": "WARNING"
        },
        "mcp.server": {
            "level": "WARNING"
        },
        "urllib3": {
            "level": "WARNING"
        }
    },
    "root": {
        "handlers": ["stderr"],
        "level": "INFO",
        "propagate": true
    }
}
